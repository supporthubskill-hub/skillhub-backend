PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillhub
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000,https://skillhub-frontend2.vercel.app

# Email verification via Resend API (preferred on Render)
RESEND_API_KEY=
RESEND_FROM=SkillHub <onboarding@resend.dev>

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkillHub <support@example.com>
